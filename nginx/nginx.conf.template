# =====================================================================
#  koyeb-tv — محطة تلفزية خفيفة على nginx فقط (بدون ffmpeg)
#  القناة 1: بث حي وهمي 24/7 من ملفات MP4/MKV عبر nginx-vod-module (mapped + live)
#  القنوات 2..8: إعادة بث روابط HLS/TS خارجية (مواقعها تُولَّد في restream_locations.conf)
#  المتغيرات أدناه تُستبدل بـ envsubst عند إقلاع الحاوية (entrypoint.sh)
# =====================================================================

worker_processes 1;
worker_rlimit_nofile 65535;

events {
    worker_connections 4096;
    multi_accept on;
}

http {
    include mime.types;
    default_type application/octet-stream;

    sendfile on;
    tcp_nopush on;
    tcp_nodelay on;
    keepalive_timeout 30s;
    server_tokens off;

    # سجلات خفيفة تناسب الخطة المجانية (لا نكتب سجل دخول إطلاقاً)
    access_log off;
    error_log ${ERROR_LOG} warn;

    # ضغط قوائم التشغيل (نصوص صغيرة، تكلفة معدومة)
    gzip on;
    gzip_comp_level 4;
    gzip_min_length 256;
    gzip_types application/vnd.apple.mpegurl application/x-mpegurl application/json text/plain text/javascript;

    # كاش وحدة vod في الذاكرة المشتركة — يوفّر المعالج والقرص
    # (كاش ذرات moov للملفات + كاش خريطة البث الحي لمدة 30 ث + كاش قوائم 2 ث)
    vod_metadata_cache meta_cache 64m 24h;
    vod_live_mapping_cache live_map 8m 30s;
    vod_live_response_cache live_resp 8m 2s;

    # كاش مقابض الملفات — يقلل استدعاءات النظام
    open_file_cache max=1000 inactive=5m;
    open_file_cache_valid 2m;
    open_file_cache_min_uses 1;
    open_file_cache_errors on;

    # Koyeb يفصل TLS قبله — نعيد بناء المخطط الصحيح للروابط المطلقة في القوائم:
    # إن وجدت ترويسة X-Forwarded-Proto نستخدمها، وإلا http (تشغيل محلي مباشر)
    map $http_x_forwarded_proto $tv_proto {
        "https"  "https";
        ""       "http";
        default  "http";
    }

    server {
        listen ${PORT};
        server_name _;

        # ---------- فحص صحة Koyeb ----------
        location = /healthz {
            access_log off;
            default_type text/plain;
            return 200 "ok\n";
        }

        # ---------- الملفات الداخلية لخريطة البث (لا تُفتح من الخارج) ----------
        location ^~ /map/ {
            internal;
            alias ${MAPS_DIR}/;
            # الخريطة تُكتب من جديد كل بضع ثوان — يجب قراءتها طازجة دائماً
            open_file_cache off;
        }

        # =====================================================
        #  القناة 1 — البث الحي 24/7 من ملفاتك (HLS)
        #  الرابط العام: /live/main/master.m3u8 أو /live/main/index.m3u8
        # =====================================================
        location ^~ /live/ {
            vod hls;
            vod_mode mapped;
            vod_upstream_location /map/;

            # روابط مطلقة بالمخطط الصحيح (https خلف Koyeb، http محلياً)
            vod_base_url $tv_proto://$http_host;

            vod_segment_duration ${SEGMENT_DURATION};
            vod_live_window_duration ${LIVE_WINDOW};
            vod_align_segments_to_key_frames on;

            # مقاطع MPEG-TS = توافق أقصى مع كل تطبيقات IPTV والأجهزة القديمة
            vod_hls_container_format mpegts;

            # ترويسات تخزين مؤقت مناسبة لكل نوع طلب
            vod_expires 1h;                    # مقاطع TS (أسماؤها ثابتة)
            vod_expires_live 1h;               # master.m3u8
            vod_expires_live_time_dependent 5s; # index.m3u8 (تتغير باستمرار)

            # السماح للمشغل ويبي وأي تطبيق IPTV بالوصول
            add_header Access-Control-Allow-Origin "*" always;
            add_header Access-Control-Allow-Methods "GET, HEAD, OPTIONS" always;
            add_header Access-Control-Allow-Headers "Origin, Range, Accept, Referer" always;
            add_header Access-Control-Expose-Headers "Server, Range, Content-Length, Content-Range" always;
        }

        # =====================================================
        #  القنوات الخارجية 2..8 (Restream — HLS أو TS)
        #  تُولَّد مواقعها آلياً عند الإقلاع من متغيرات
        #  RESTREAM_URL / RESTREAM_URL_2..8 بواسطة gen_restream.py
        # =====================================================
        include /var/vod/restream_locations.conf;

        # ---------- إعدادات المشغل لصفحة الويب ----------
        location = /config.js {
            alias ${CONFIG_JS};
            default_type application/javascript;
            add_header Cache-Control "no-store";
        }

        # ---------- صفحة المشغل ----------
        location / {
            root ${WWW_DIR};
            index index.html;
        }
    }
}
